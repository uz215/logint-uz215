        <mxCell id="rw_calc" value="Rw自动检测&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;来自15个典型水层&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;sqrt(Rw)50% = 2.5264&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;Rw = 6.3826 Ω·m&lt;/span&gt;" style="shape=process;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00" vertex="1" parent="1">
          <mxGeometry x="800" y="1160" width="160" height="70" as="geometry"/>
