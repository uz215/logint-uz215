        <!-- ==================== SECTION 4: 岩性识别 ==================== -->
        <mxCell id="s4_title" value="&lt;b&gt;第四阶段: 岩性识别 (6步子流程)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=#D4E6F1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="50" y="570" width="1500" height="30" as="geometry"/>
        </mxCell>
        
        <mxCell id="lith_sub" value="&lt;b&gt;岩性识别子流程&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align:left;padding:5px;font-size:10px&quot;&gt;&lt;div style=&quot;margin-bottom:3px&quot;&gt;&lt;b&gt;a) PE曲线质量检查&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-left:10px;color:#B85450&quot;&gt;✗ PE绝对值不可信(99%&amp;gt;3.0)&lt;/div&gt;&lt;div style=&quot;margin-left:10px&quot;&gt;仅趋势可用 → 跳过PE约束&lt;/div&gt;&lt;br/&gt;&lt;div style=&quot;margin-bottom:3px&quot;&gt;&lt;b&gt;b) GR基线自动识别&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-left:10px&quot;&gt;泥岩GR基线 = 129.5 API&lt;/div&gt;&lt;br/&gt;&lt;div style=&quot;margin-bottom:3px&quot;&gt;&lt;b&gt;c) 剖面类型判定&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-left:10px&quot;&gt;交汇图分析 → 砂泥岩剖面(sand_shale)&lt;/div&gt;&lt;br/&gt;&lt;div style=&quot;margin-bottom:3px&quot;&gt;&lt;b&gt;d) 矿物定量计算&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-left:10px&quot;&gt;L1正则化优化 Qu/Ca/Do/Clay...&lt;/div&gt;&lt;div style=&quot;margin-left:10px&quot;&gt;α=0.15, 失败率100%(警告)&lt;/div&gt;&lt;br/&gt;&lt;div style=&quot;margin-bottom:3px&quot;&gt;&lt;b&gt;e) 岩性分段 + 边界平滑&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-left:10px&quot;&gt;滑动窗口(50点) → 9个边界点&lt;/div&gt;&lt;div style=&quot;margin-left:10px&quot;&gt;砂泥岩段100%,碳酸盐岩0%&lt;/div&gt;&lt;br/&gt;&lt;div style=&quot;margin-bottom:3px&quot;&gt;&lt;b&gt;f) 特殊矿物检测&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;margin-left:10px&quot;&gt;蒸发岩环境评估 → 无&lt;/div&gt;&lt;div style=&quot;margin-left:10px&quot;&gt;特殊矿物点: 0&lt;/div&gt;&lt;/div&gt;" style="shape=note;size=50;align=left;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="600" y="620" width="380" height="280" as="geometry"/>
        </mxCell>
        
        <mxCell id="lith_output" value="输出:LITHOLOGY列&lt;br&gt;sandstone / shale" style="shape=rectangle;perimeter=rectanglePerimeter;fixedSize=1;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366" vertex="1" parent="1">
          <mxGeometry x="1060" y="630" width="150" height="60" as="geometry"/>
