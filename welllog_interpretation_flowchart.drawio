        <mxCell id="interp_process" value="多参数联合判别&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;特征映射: RT→LLD, SW→Sw,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;PHI→PHI, VSH→Vsh&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;阈值法: Sw, Vsh, Rt, Phi&lt;/span&gt;" style="shape=process;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00" vertex="1" parent="1">
