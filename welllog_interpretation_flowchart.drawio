        <!-- ==================== SECTION 5: 孔隙度计算 ==================== -->
        <mxCell id="s5_title" value="&lt;b&gt;第五阶段: 孔隙度计算 (7种方法并行)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=#D4E6F1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="50" y="920" width="1500" height="30" as="geometry"/>
        </mxCell>
        
        <mxCell id="phi_methods" value="&lt;b&gt;7种孔隙度计算方法:&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;M1: 密度泥质校正法 (PHI_DEN_SHALE)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;M2: 声波泥质校正法&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;M3: 中子泥质校正法&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;M4: 中子-密度加权平均&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;M5: 交会图法(岩性加权)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;M6: 中子密度算术平均&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;M7: 中子声波几何平均&lt;/span&gt;" style="shape=process;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00" vertex="1" parent="1">
          <mxGeometry x="750" y="950" width="200" height="130" as="geometry"/>
