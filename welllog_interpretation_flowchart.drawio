        <mxCell id="phi_main" value="主孔隙度选择&lt;br&gt;PHI = PHI_DEN_SHALE&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;有效点: 25142&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;均值: 0.226&lt;/span&gt;" style="shape=rectangle;rx=5;ry=5;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366" vertex="1" parent="1">
          <mxGeometry x="1020" y="955" width="150" height="70" as="geometry"/>
