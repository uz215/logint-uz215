        <!-- 9道概览表格 -->
        <mxCell id="tracks_table" value="&lt;b&gt;Track布局一览表:&lt;/b&gt;&lt;table border='1' cellpadding='5' style='font-size:10px;border-collapse:collapse;width:100% '&gt;&lt;tr style='background:#D4E6F1'&gt;&lt;th&gt;道号&lt;/th&gt;&lt;th&gt;名称&lt;/th&gt;&lt;th&gt;宽度比&lt;/th&gt;&lt;th&gt;渲染方式&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;LITHOLOGY&lt;/td&gt;&lt;td&gt;0.5&lt;/td&gt;&lt;td&gt;黄底黑点/绿底Shale tile&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;POROSITY&lt;/td&gt;&lt;td&gt;0.6&lt;/td&gt;&lt;td&gt;PHI曲线 + 矿物tile&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;RESISTIVITY&lt;/td&gt;&lt;td&gt;0.5&lt;/td&gt;&lt;td&gt;MSFL/LLS/LLD semilog&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;DEPTH&lt;/td&gt;&lt;td&gt;0.5&lt;/td&gt;&lt;td&gt;深度刻度&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;SW&lt;/td&gt;&lt;td&gt;1.0&lt;/td&gt;&lt;td&gt;饱和度曲线&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;FACIES&lt;/td&gt;&lt;td&gt;1.0&lt;/td&gt;&lt;td&gt;沉积相色块&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;7&lt;/td&gt;&lt;td&gt;LITH_FILL&lt;/td&gt;&lt;td&gt;1.0&lt;/td&gt;&lt;td&gt;岩性填充&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#E1D5E7'&gt;&lt;td&gt;8&lt;/td&gt;&lt;td&gt;PROFILE&lt;/td&gt;&lt;td&gt;0.75&lt;/td&gt;&lt;td&gt;矿物堆叠fill+符号tile&lt;/td&gt;&lt;/tr&gt;&lt;tr style='background:#FFE6CC'&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;INTERPRETATION&lt;/td&gt;&lt;td&gt;1.0&lt;/td&gt;&lt;td&gt;油气水层色块+编号&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=note;size=60;align=left;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11" vertex="1" parent="1">
