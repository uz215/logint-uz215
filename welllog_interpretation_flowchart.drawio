        <mxCell id="post1" value="非储层孔隙度归零&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;PHI=0 (NonReservoir)&lt;/span&gt;" style="shape=rectangle;rx=5;ry=5;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366" vertex="1" parent="1">
          <mxGeometry x="800" y="1480" width="160" height="50" as="geometry"/>
        </mxCell>
        
        <mxCell id="post2" value="非储层矿物重分配&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;sum(minerals)=1.0&lt;/span&gt;" style="shape=rectangle;rx=5;ry=5;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366" vertex="1" parent="1">
