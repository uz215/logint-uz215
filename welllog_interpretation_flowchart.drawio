        <mxCell id="sw_calc" value="Arps公式计算Sw&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;电阻率列: LLD&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;范围: 0.208 - 1.000&lt;/span&gt;" style="shape=rectangle;rx=5;ry=5;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366" vertex="1" parent="1">
          <mxGeometry x="1040" y="1160" width="150" height="70" as="geometry"/>
