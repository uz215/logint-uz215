          <mxGeometry x="50" y="450" width="1500" height="30" as="geometry"/>
        </mxCell>
        
        <mxCell id="spring_detect" value="RHOB弹簧段检测&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;三条件判断:&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;①跳跃率&gt;30%&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;②周期性一致&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px&quot;&gt;③与GR无关&lt;/span&gt;" style="shape=process;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00" vertex="1" parent="1">
