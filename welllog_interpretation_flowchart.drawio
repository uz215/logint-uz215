        <!-- ==================== SECTION 6: 饱和度计算 ==================== -->
        <mxCell id="s6_title" value="&lt;b&gt;第六阶段: 含水饱和度计算&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=#D4E6F1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=14;fontStyle=1" vertex="1" parent="1">
