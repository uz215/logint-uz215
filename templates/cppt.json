{
  "meta": {
    "format": "cppt",
    "name": "流体/岩性交会图 Crossplot 图版",
    "version": "1.0",
    "updated": "2026-10-10",
    "note": "本文件为流体交会图（visualization_fluid 模块）的图版定义。logvis.visualize_fluid 读取本图版并透传给 visualize_fluid_crossplots；未配置的键用代码内置默认值。修改本文件可改变交会图组合、轴、颜色与版式，无需改代码。"
  },
  "figure": {
    "figsize": [
      11.5,
      8.6
    ],
    "dpi": 150,
    "subplots_adjust": {
      "top": 0.885,
      "bottom": 0.085,
      "left": 0.085,
      "right": 0.975
    },
    "note": "figsize 为每张交会图画布尺寸（英寸）；subplots_adjust 为画布内绘图区边距；dpi 为输出分辨率。"
  },
  "min_thickness": 3.0,
  "note_min_thickness": "层段最小厚度（米/英尺单位与主数据一致，小于该厚度不参与编号，避免碎层）",
